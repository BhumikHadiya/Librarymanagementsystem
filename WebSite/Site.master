<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="assets/css/site.css" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">
        <div class="app-wrapper">

            <!-- ===== Sidebar ===== -->
            <nav id="sidebar" class="sidebar">
                <div class="sidebar-brand">
                    <i class="bi bi-book-half"></i>
                    <span>College Library</span>
                </div>
                <ul class="nav flex-column">
                    <li><a class="<%= NavClass("Default.aspx") %>" href="Default.aspx"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li class="nav-section">Catalogue</li>
                    <li><a class="<%= NavClass("Books.aspx", "BookForm.aspx") %>" href="Books.aspx"><i class="bi bi-journal-bookmark"></i> Books</a></li>
                    <li><a class="<%= NavClass("Categories.aspx") %>" href="Categories.aspx"><i class="bi bi-tags"></i> Categories</a></li>
                    <li class="nav-section">Members</li>
                    <li><a class="<%= NavClass("Students.aspx", "StudentForm.aspx") %>" href="Students.aspx"><i class="bi bi-people"></i> Students</a></li>
                    <li class="nav-section">Circulation</li>
                    <li><a class="<%= NavClass("IssueBook.aspx") %>" href="IssueBook.aspx"><i class="bi bi-box-arrow-up-right"></i> Issue Book</a></li>
                    <li><a class="<%= NavClass("ReturnBook.aspx") %>" href="ReturnBook.aspx"><i class="bi bi-box-arrow-in-down-left"></i> Return Book</a></li>
                    <li><a class="<%= NavClass("Reports.aspx") %>" href="Reports.aspx"><i class="bi bi-file-earmark-bar-graph"></i> Reports</a></li>
                    <li class="nav-section">Account</li>
                    <li><a class="<%= NavClass("ChangePassword.aspx") %>" href="ChangePassword.aspx"><i class="bi bi-key"></i> Change Password</a></li>
                </ul>
            </nav>
            <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

            <!-- ===== Main area ===== -->
            <div class="main">
                <header class="topbar">
                    <button type="button" id="sidebarToggle" class="btn btn-outline-secondary btn-sm d-lg-none" aria-label="Open menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <h1 class="page-title"><%: Page.Title %></h1>
                    <div class="topbar-user">
                        <span class="d-none d-sm-inline text-muted"><i class="bi bi-person-circle"></i>
                            <asp:Literal ID="litAdminName" runat="server" /></span>
                        <asp:LinkButton ID="lnkLogout" runat="server" CssClass="btn btn-sm btn-outline-danger"
                            OnClick="lnkLogout_Click" CausesValidation="false">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </asp:LinkButton>
                    </div>
                </header>

                <main class="content">
                    <asp:Literal ID="litFlash" runat="server" />
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>

                <footer class="footer">Library Management System &copy; <%= DateTime.Now.Year %></footer>
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/site.js"></script>
</body>
</html>
