<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- =============================================================
       DATABASE CONNECTION
       Change "Data Source" to match YOUR SQL Server instance:
         LocalDB (installed with Visual Studio) : (localdb)\MSSQLLocalDB
         SQL Server Express                     : .\SQLEXPRESS
         Full SQL Server (default instance)     : .   or   localhost
       Integrated Security=True uses your Windows login.
       For SQL authentication use instead:
         Data Source=.\SQLEXPRESS;Initial Catalog=LibraryDB;User ID=sa;Password=YourPassword;
       ============================================================= -->
  <connectionStrings>
    <add name="LibraryDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=LibraryDB;Integrated Security=True;MultipleActiveResultSets=False;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Library rules (change as needed) -->
    <add key="MaxBooksPerStudent" value="3" />
    <add key="LoanPeriodDays" value="14" />
    <add key="FinePerDay" value="5" />
    <add key="CurrencySymbol" value="₹" />

    <!-- Lets ASP.NET validators work without jQuery -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" enableVersionHeader="false" />

    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />

    <!-- Admin session expires after 30 minutes of inactivity -->
    <sessionState mode="InProc" timeout="30" cookieless="UseCookies" />
    <httpCookies httpOnlyCookies="true" />

    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />

    <!-- Friendly error page for users; full errors still visible on localhost -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>
